{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"files": {
		"includes": ["**", "!dist/**", "!node_modules/**", "!coverage/**", "!CHANGELOG.md"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf",
		"bracketSpacing": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		// ESLint (n8n strict) lints every *.ts in the repo and is the n8n Cloud
		// verification gate, so it owns linting by default. Biome's linter is
		// opted INTO per-path below, and only for rules ESLint does not already
		// cover -- a duplicated rule is just the same error reported twice.
		"enabled": false,
		"rules": {
			"preset": "none"
		}
	},
	"overrides": [
		{
			// Pure-TypeScript layers: no n8n node/credential surface, so Biome's
			// small non-overlapping rule set is worth running here.
			"includes": ["shared/**", "contexts/**"],
			"linter": {
				"enabled": true,
				"rules": {
					"correctness": {
						// Overlaps ts-eslint's no-unused-vars, but unlike ESLint this
						// has a safe autofix, so `biome check --write` on pre-commit
						// deletes dead imports before ESLint ever complains.
						"noUnusedImports": "error"
					},
					"style": {
						"useConst": "error"
					},
					"performance": {
						"noBarrelFile": "error",
						"noReExportAll": "error"
					}
				}
			}
		},
		{
			// The layer rule, machine-checked. Domain code must stay runnable and
			// testable without the n8n runtime; ESLint cannot enforce this because
			// `n8n-node lint` byte-compares eslint.config.mjs against a frozen
			// template and rejects any edit.
			"includes": ["shared/domain/**", "contexts/*/domain/**"],
			"linter": {
				"enabled": true,
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"n8n-workflow": "Domain code must not depend on the n8n runtime. Put the adapter in shared/infrastructure/ instead."
								}
							}
						}
					}
				}
			}
		},
		{
			// The context rule, machine-checked, so the review does not have to
			// re-derive it every round. Patterns match the import specifier, and a
			// context only ever names another context by name -- its own files are
			// reached relatively -- so a segment naming any context is the violation.
			"includes": ["contexts/*/**"],
			"linter": {
				"enabled": true,
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/archive/**",
											"**/ingestion/**",
											"**/taxonomy/**",
											"**/sharing/**",
											"**/automation/**",
											"**/access/**",
											"**/system/**"
										],
										"message": "One context must not import another. What both need belongs in shared/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// `n8n-node` rewrites package.json through Prettier with only
			// { parser: 'json' }, so it never sees this repo's config and always
			// emits 2-space indentation. Matching that here keeps every
			// CLI-driven package.json edit from producing a formatting diff.
			"includes": ["package.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		}
	]
}
