{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"commit": "",
		"pr": "",
		"sessionUrl": false
	},
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run typecheck)",
			"Bash(npm run typecheck:test)",
			"Bash(npm run test)",
			"Bash(npm test)",
			"Bash(npm run build)",
			"Bash(npx biome check:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)"
		]
	}
}
