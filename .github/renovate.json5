// Renovate over Dependabot: this repo publishes to npm with a provenance
// attestation, which makes the dependency pipeline itself a target. Dependabot
// covers the basics -- it has a `cooldown` setting, documented at
// https://docs.github.com/en/code-security/dependabot/working-with-dependabot/dependabot-options-reference#cooldown-
// -- and keeps SHA-pinned actions current from their version comment. What it does not
// give is the rest of this file: an OpenSSF Scorecard in every PR body,
// `lockFileMaintenance` for transitive dev CVEs no direct bump ever reaches, and
// a dependency dashboard listing what is being held back and why.
//
// Dependabot alerts stay ON at the repo level. They are the detector Renovate's
// `vulnerabilityAlerts` consumes; only Dependabot's PR-opening halves are off.
//
// JSON5 rather than JSON so this reasoning can live next to the settings.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    // Surfaces each dependency's OpenSSF Scorecard in the PR body: maintenance
    // activity, branch protection, whether releases are signed. A dependency
    // whose score just collapsed is the cheapest takeover signal available.
    'security:openssf-scorecard',
  ],

  timezone: 'Europe/Berlin',
  // Daily rather than weekly: `schedule` gates branch updates too, so a
  // Monday-only window plus the three-day cooldown pushes a Friday release out
  // by a full extra week. Grouping, not the schedule, is what keeps the PR
  // count down.
  schedule: ['before 6am'],
  prConcurrentLimit: 5,

  // The single most effective defence against a compromised npm release. The
  // shai-hulud class of attack -- stolen maintainer token, malicious version
  // published, credentials harvested from postinstall -- is typically caught and
  // yanked within hours. Waiting three days means the registry, not this repo,
  // absorbs that window. `strict` is already Renovate's documented default for
  // `internalChecksFilter` (https://docs.renovatebot.com/configuration-options/#internalchecksfilter);
  // it is written out so a change to that default cannot silently downgrade the
  // cooldown from a gate to a PR annotation.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',

  // commitlint (commitlint.config.mjs) enforces a closed scope-enum on this
  // repo, so the bot's commit subjects are pinned rather than left to
  // Renovate's defaults -- `chore(deps-dev)` and bare `chore(typescript)` would
  // both be rejected.
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',

  // Transitive dev CVEs (the undici / nanoid / uuid cluster under
  // @n8n/node-cli and n8n-workflow) are only reachable through the lockfile;
  // no direct-dependency bump ever proposes them.
  //
  // The one hole in the cooldown: `minimumReleaseAge` does not apply to
  // lockFileMaintenance -- Renovate's update-type support matrix marks it
  // unsupported because the package manager, not Renovate, resolves the tree
  // (https://docs.renovatebot.com/key-concepts/minimum-release-age/#which-update-types-take-minimumreleaseage-into-account),
  // so a version published that morning can land in this PR. It is monthly;
  // read its diff for versions younger than three days rather than the
  // changelog links.
  //
  // It also has no depName, so no packageRule below can match it -- the
  // `enabled: false` holds are unreachable from here, and only the range in
  // package.json bounds what a re-resolve may pick. That is why @n8n/node-cli
  // carries `^0.44.1` rather than the `*` the scaffold shipped: within a 0.x
  // caret it can move by patch, which is exactly what its rule allows anyway.
  //
  // n8n-workflow cannot be bounded the same way -- `valid-peer-dependencies`
  // requires the peer to be literally `*`, and `no-overrides-field` closes the
  // other route -- so this PR can move it in the lockfile. It is harmless: the
  // package ships `dist` only and declares no runtime dependencies, so that
  // version reaches typecheck, test and build and nothing else. A bump landing
  // green is the compatibility signal; a bump landing red is the bug report.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on the first day of the month'],
  },

  vulnerabilityAlerts: {
    enabled: true,
    // Both restate this object's documented defaults -- `minimumReleaseAge: null`
    // and an empty `schedule`, of which `at any time` is the spelled-out form
    // (https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts).
    // They are written out because they are the exemption that matters: a
    // known-exploited hole outranks the cooldown and the schedule, and a change
    // to either default would otherwise leave a published fix sitting unproposed.
    minimumReleaseAge: null,
    schedule: ['at any time'],
    labels: ['security'],
  },
  // Adds OSV as a second vulnerability source alongside the GitHub Advisory
  // Database. Still flagged experimental upstream and limited to *direct*
  // dependencies -- the transitive dev CVEs above stay out of its reach, which
  // is why lockFileMaintenance carries that job.
  osvVulnerabilityAlerts: true,

  packageRules: [
    {
      // The package ships zero runtime dependencies, so every npm update here is
      // tooling. One rolling PR beats eight separate ones.
      matchManagers: ['npm'],
      matchDepTypes: ['devDependencies'],
      groupName: 'dev-dependencies',
    },
    {
      // n8n-workflow is a peer dependency: its range declares which n8n versions
      // this node supports. Widening or moving it is a compatibility decision
      // that belongs to a human reading the n8n changelog, not to a bot.
      // Largely belt-and-braces: n8n's own lint pins the declared range to `*`,
      // which no update can widen. It is kept so that a future relaxation of
      // that rule does not silently hand the range to the bot.
      matchPackageNames: ['n8n-workflow'],
      enabled: false,
    },
    {
      // The CLI's major version is tied to the node API, and release.yml calls
      // it for `build`, `lint` and the `prerelease` guard in prepublishOnly --
      // the three places a break would surface. Minor is listed too because the package
      // is still 0.x, where 0.23 -> 0.24 carries exactly those breaks; drop it
      // once it reaches 1.0. The `^0.44.1` range in package.json is the other
      // half of this hold -- see lockFileMaintenance above, which this rule
      // cannot reach.
      matchPackageNames: ['@n8n/node-cli'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
      semanticCommitType: 'ci',
      // A version tag is mutable: whoever owns the action's repo can repoint v7
      // at any commit, and every workflow using it runs that commit on the next
      // push. Pinning to a digest removes that. Renovate then owns keeping the
      // pins current, which is the only reason pinning is sustainable.
      pinDigests: true,
    },
  ],
}
